# --- Required for live LLM runs (leave blank to use --no-llm / offline mode) ---
OPENAI_API_KEY=""

# --- Weather (Open-Meteo, no key needed; location configurable) ---
WEATHER_LAT="40.7282"
WEATHER_LON="-74.0776"
WEATHER_TZ="America/New_York"

# --- Optional email delivery (leave REPORT_EMAIL_TO blank to disable sending) ---
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
REPORT_EMAIL_TO=""

# --- Optional LangSmith tracing (leave blank to disable) ---
LANGCHAIN_TRACING_V2=""
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="SeeWeeS_WhatIf"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# --- Data paths (defaults are fine) ---
DATA_AUGMENTED_DIR="data-augmented"
